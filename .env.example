# CARECIRCLE AI Environment Configuration
# Care that connects. Intelligence that protects.
# Copy this file to .env and provide your valid credentials

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=carecircle-ai-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=carecircle-ai-demo
VITE_FIREBASE_STORAGE_BUCKET=carecircle-ai-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Google Gemini API
# In development/hackathon demo, VITE_GEMINI_API_KEY is used by the Gemini client service.
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL=gemini-1.5-flash

# Application Identity
VITE_APP_NAME="CareCircle AI"
VITE_APP_TAGLINE="Care that connects. Intelligence that protects."
VITE_APP_ENV=development

# Fallback & Mock Data Settings (true enables full realistic UI demo when keys are unconfigured)
VITE_ENABLE_MOCK_FALLBACK=true
